SMTP_SECURE=1
SMTP_USER=change_me@example.com
SMTP_PASS=change_me
SMTP_FROM=change_me@example.com
SMTP_CA_PATH=
SMTP_TLS_REJECT_UNAUTHORIZED=1

TELEGRAM_LOGIN_TOKEN=
TELEGRAM_LOGIN_CHAT_ID=
TELEGRAM_ALERT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
