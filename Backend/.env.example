LOGIN_APPROVAL_END_HOUR=17

VIRUSTOTAL_API_KEY=
MONGODB_URI=

OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5

RATE_LIMIT_ENABLED=1
