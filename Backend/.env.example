ELASTIC_USERNAME=elastic_user
ELASTIC_PASSWORD=change_me
ELASTIC_INDEX=wazuh-alerts-*
ELASTIC_CA_PATH=
ELASTIC_TLS_REJECT_UNAUTHORIZED=1

JWT_SECRET=replace_with_at_least_32_random_bytes
