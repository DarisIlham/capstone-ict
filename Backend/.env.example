RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_OTP_WINDOW_MS=900000
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_RESET_WINDOW_MS=3600000
RATE_LIMIT_RESET_MAX=5
RATE_LIMIT_RESET_VERIFY_WINDOW_MS=3600000
RATE_LIMIT_RESET_VERIFY_MAX=30
RATE_LIMIT_DATA_WINDOW_MS=60000
RATE_LIMIT_DATA_MAX=1000

HUNTING_MAX_RANGE_DAYS=366
